<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
	<apiVersion>61.0</apiVersion>
	<isExposed>true</isExposed>
	<masterLabel>Lwc builder demo</masterLabel>
	<description>Demo component created using LWC Builder</description>
	<targets>
		<target>lightning__AppPage</target>
		<target>lightning__HomePage</target>
		<target>lightning__RecordPage</target>
	</targets>
	<targetConfigs>
		<targetConfig targets="lightning__AppPage">
			<property name="title" type="String" default="Welcome to LWC Builder" description="Title displayed by the component" label="Component Title" />
			<property name="showMessage" type="Boolean" default="true" description="Controls whether the welcome message is displayed" label="Show Welcome Message" />
			<supportedFormFactors>
				<supportedFormFactor type="Small"/>
				<supportedFormFactor type="Large"/>
			</supportedFormFactors>
		</targetConfig>
		<targetConfig targets="lightning__HomePage">
			<supportedFormFactors>
				<supportedFormFactor type="Large"/>
			</supportedFormFactors>
		</targetConfig>
		<targetConfig targets="lightning__RecordPage">
			<supportedFormFactors>
				<supportedFormFactor type="Small"/>
				<supportedFormFactor type="Large"/>
			</supportedFormFactors>
		</targetConfig>
	</targetConfigs>
</LightningComponentBundle>