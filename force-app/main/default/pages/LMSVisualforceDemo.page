<apex:page>
    <div style="padding: 10px; font-family: Arial, sans-serif;">
        <label for="messageInput">Message to publish</label><br/>
        <input type="text" id="messageInput" style="width: 100%; padding: 6px; margin: 6px 0;" /><br/>
        
        <button onclick="publishMessage()" style="padding: 6px 12px; margin-right: 5px; cursor: pointer;">Publish</button>
        <button onclick="subscribeMC()" style="padding: 6px 12px; margin-right: 5px; cursor: pointer;">Subscribe</button>
        <button onclick="unsubscribeMC()" style="padding: 6px 12px; cursor: pointer;">Unsubscribe</button>
        
        <p style="margin-top: 15px; font-weight: bold;">
            Message received: <span id="receivedMessage" style="font-weight: normal; color: #0176d3;"></span>
        </p>
    </div>

    <script>
        // 1. Reference the Message Channel
        let SAMPLE_MC = "{!$MessageChannel.SampleMessageChannel__c}";
        let subscriptionToMC = null;

        // 2. Publish a message from Visualforce
        function publishMessage() {
            let inputVal = document.getElementById("messageInput").value;
            let payload = {
                lmsData: {
                    value: inputVal
                }
            };
            sforce.one.publish(SAMPLE_MC, payload);
        }

        // 3. Subscribe to the channel
        function subscribeMC() {
            if (!subscriptionToMC) {
                subscriptionToMC = sforce.one.subscribe(SAMPLE_MC, onMessageCallback);
                console.log("Subscribed successfully to LMS in Visualforce");
            }
        }

        // 4. Handle incoming message from LWC / Aura
        function onMessageCallback(message) {
            console.log("Visualforce received message:", message);
            // Check if message and lmsData exist safely
            if (message && message.lmsData) {
                document.getElementById("receivedMessage").innerText = message.lmsData.value;
            } else if (message && message.value) {
                document.getElementById("receivedMessage").innerText = message.value;
            }
        }

        // 5. Unsubscribe from the channel
        function unsubscribeMC() {
            if (subscriptionToMC) {
                sforce.one.unsubscribe(subscriptionToMC);
                subscriptionToMC = null;
                console.log("Unsubscribed successfully in Visualforce");
            }
        }
    </script>
</apex:page>